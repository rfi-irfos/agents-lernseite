{
  "name": "agents-lernseite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run check-copy && vitest run",
    "check-copy": "esbuild scripts/check-copy.ts --bundle --platform=node --format=esm --outfile=test-out/check-copy.mjs --log-level=warning && node test-out/check-copy.mjs",
    "copy-sheet": "esbuild scripts/copy-sheet.ts --bundle --platform=node --format=esm --outfile=test-out/copy-sheet.mjs --log-level=warning && node test-out/copy-sheet.mjs",
    "contact-sheet": "esbuild scripts/contact-sheet.ts --bundle --platform=node --format=esm --packages=external --outfile=test-out/contact-sheet.mjs --log-level=warning && node test-out/contact-sheet.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
